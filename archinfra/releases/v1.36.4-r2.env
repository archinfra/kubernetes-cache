# Archinfra Kubernetes distribution release lock
# Canonical input for release cache builds. Release workflows MUST NOT resolve "latest".

RELEASE=v1.36.4-r2
RELEASE_VERSION=v1.36.4-r2

# BOM format revision. SOURCE_COMMIT / BUILD_DATE are stamped by the release-build
# pipeline at build time so the shipped artifact is traceable back to a commit.
BOM_VERSION=1
SOURCE_COMMIT=
BUILD_DATE=

# The canonical lock is linux/amd64. Multi-arch builds keep the arch that the
# invoking workflow sets; this ARCH is the BOM's recorded target architecture.
ARCH=amd64

# Core distribution versions (independently selected).
KUBERNETES_VERSION=1.36.4
SEALOS_VERSION=5.1.1
DOCKER_VERSION=28.5.2
CONTAINERD_VERSION=1.7.28
CRI_DOCKERD_VERSION=0.4.6
CRICTL_VERSION=1.36.0
RUNC_VERSION=1.3.3
REGISTRY_VERSION=2.8.3

# Images pinned by kubeadm v1.36.4. Derived from kubeadm defaults, recorded
# here rather than independently selected.
PAUSE_VERSION=3.10.2
COREDNS_VERSION=1.14.2
ETCD_VERSION=3.6.8-0

# Docker-owned runtime dependency. Recorded in the BOM but not independently replaced.
DOCKER_BUNDLED_RUNC_VERSION=1.3.3
LVSCARE_VERSION=v5.1.1

# Backward-compatible aliases retained from v1.36.4-r1 for consumers reading the
# kubeadm-derived names.
KUBEADM_ETCD_VERSION=3.6.8-0
KUBEADM_COREDNS_VERSION=v1.14.2
KUBEADM_PAUSE_VERSION=3.10.2

# Verified upstream artifact digests (linux/amd64).
DOCKER_SHA256=ea90cfd12e1eeb12aa1c971741adb8bd4ed88e2a574eaac13f5029a1dbc6300d
CONTAINERD_SHA256=659eceb8a5831a704089825d980f63abfb686650646751e13f9f9fac780ea08e
CRI_DOCKERD_SHA256=3fcad9ab2960357ece7a978e0f759dc90c11b9890d79f573b64bf908015f18ca
CRICTL_SHA256=83855e114566a8a8c44c548d515670f51de3a5e1da8b2effb59870e2f10c25a3
REGISTRY_SHA256=b1f750ecbe09f38e2143e22c61a25e3da2afe1510d9522859230b480e642ceff
SEALOS_SHA256=8437466aa34bb54f6de70ca141a891a24f9e6b64fc8e40a85b177682bb312ff2

# Cache image base used only to provide /bin/sh for the current runtime's Sealos-copy step.
# Pinned to the linux/amd64 manifest digest of alpine:3.22.2.
SEALOS_CACHE_BASE_IMAGE=alpine:3.22.2@sha256:85f2b723e106c34644cd5851d7e81ee87da98ac54672b29947c052a45d31dc2f

# Release-oriented cache tags. No floating production aliases are published.
SEALOS_CACHE_TAG=sealos-v5.1.1-amd64
KUBERNETES_CACHE_TAG=kubernetes-v1.36.4-amd64
CRICTL_CACHE_TAG=cri-v1.36-amd64
DOCKER_CACHE_TAG=cri-docker-v28.5.2-cridockerd-v0.4.6-registry-v2.8.3-amd64

# Upstream artifact URLs (linux/amd64).
DOCKER_URL=https://download.docker.com/linux/static/stable/x86_64/docker-28.5.2.tgz
CONTAINERD_URL=https://github.com/containerd/containerd/releases/download/v1.7.28/containerd-static-1.7.28-linux-amd64.tar.gz
CRI_DOCKERD_URL=https://github.com/yuanyp8/cri-dockerd/releases/download/v0.4.6-archinfra/cri-dockerd-0.4.6.amd64.tgz
CRICTL_URL=https://github.com/kubernetes-sigs/cri-tools/releases/download/v1.36.0/crictl-v1.36.0-linux-amd64.tar.gz
REGISTRY_URL=https://github.com/distribution/distribution/releases/download/v2.8.3/registry_2.8.3_linux_amd64.tar.gz
SEALOS_URL=https://github.com/labring/sealos/releases/download/v5.1.1/sealos_5.1.1_linux_amd64.tar.gz

# Legacy compatibility utilities inherited from the original Sealos cache chain.
# Their exact downloaded hashes are recorded in build provenance. They are deliberately marked legacy
# until replaced with independently versioned Archinfra sources in a later hardening release.
CONNTRACK_URL=https://github.com/labring/cluster-image/releases/download/depend/library-2.5-linux-amd64.tar.gz
LSOF_URL=https://github.com/labring/cluster-image/releases/download/depend/lsof-linux-amd64

# ---------------------------------------------------------------------------
# linux/arm64 variants (canonical lock remains amd64 above; these are picked by
