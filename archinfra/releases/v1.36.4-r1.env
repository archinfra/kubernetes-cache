# Archinfra Kubernetes distribution release lock
# Canonical input for release cache builds. Release workflows MUST NOT resolve "latest".

RELEASE_VERSION=v1.36.4-r1
ARCH=amd64

KUBERNETES_VERSION=1.36.4
SEALOS_VERSION=5.1.1
DOCKER_VERSION=28.5.2
CRI_DOCKERD_VERSION=0.4.4
CRICTL_VERSION=1.36.0
REGISTRY_VERSION=3.1.1

# Versions derived from kubeadm v1.36.4 defaults. Recorded here; not independently selected.
KUBEADM_ETCD_VERSION=3.6.8-0
KUBEADM_COREDNS_VERSION=v1.14.2
KUBEADM_PAUSE_VERSION=3.10.2
LVSCARE_VERSION=v5.1.1

# Docker-owned runtime dependencies. They are recorded in the BOM but are not independently replaced.
DOCKER_BUNDLED_RUNC_VERSION=1.3.3

# Verified upstream artifact digests (linux/amd64).
DOCKER_SHA256=ea90cfd12e1eeb12aa1c971741adb8bd4ed88e2a574eaac13f5029a1dbc6300d
CRI_DOCKERD_SHA256=109b7540053a507dd85ad7b9fee9cee9caae55feedcc28365d3e7ab4fb2172d5
CRICTL_SHA256=83855e114566a8a8c44c548d515670f51de3a5e1da8b2effb59870e2f10c25a3
REGISTRY_SHA256=6f330a3ba9ea1d23a6ee189f449d792595240585bb2f159123d76ac594f70dd8
SEALOS_SHA256=8437466aa34bb54f6de70ca141a891a24f9e6b64fc8e40a85b177682bb312ff2

# Release-oriented cache tags. No floating production aliases are published.
SEALOS_CACHE_TAG=sealos-v5.1.1-amd64
KUBERNETES_CACHE_TAG=kubernetes-v1.36.4-amd64
CRICTL_CACHE_TAG=cri-v1.36-amd64
DOCKER_CACHE_TAG=cri-docker-v28.5.2-cridockerd-v0.4.4-registry-v3.1.1-amd64

DOCKER_URL=https://download.docker.com/linux/static/stable/x86_64/docker-28.5.2.tgz
CRI_DOCKERD_URL=https://github.com/Mirantis/cri-dockerd/releases/download/v0.4.4/cri-dockerd-0.4.4.amd64.tgz
CRICTL_URL=https://github.com/kubernetes-sigs/cri-tools/releases/download/v1.36.0/crictl-v1.36.0-linux-amd64.tar.gz
REGISTRY_URL=https://github.com/distribution/distribution/releases/download/v3.1.1/registry_3.1.1_linux_amd64.tar.gz
SEALOS_URL=https://github.com/labring/sealos/releases/download/v5.1.1/sealos_5.1.1_linux_amd64.tar.gz

# Legacy compatibility utilities inherited from the original Sealos cache chain.
# Their exact downloaded hashes are recorded in build provenance. They are deliberately marked legacy
# until replaced with independently versioned Archinfra sources in a later hardening release.
CONNTRACK_URL=https://github.com/labring/cluster-image/releases/download/depend/library-2.5-linux-amd64.tar.gz
LSOF_URL=https://github.com/labring/cluster-image/releases/download/depend/lsof-linux-amd64
